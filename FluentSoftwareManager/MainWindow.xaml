<Window
    x:Class="FluentSoftwareManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Fluent Software Manager">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title Bar -->
        <Grid Grid.Row="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" Margin="16,0">
                <FontIcon Glyph="&#xE896;" FontSize="20" VerticalAlignment="Center"/>
                <TextBlock Text="Fluent Software Manager"
                          FontSize="16"
                          FontWeight="SemiBold"
                          VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Navigation View -->
        <NavigationView Grid.Row="1"
                       x:Name="NavView"
                       IsBackButtonVisible="Collapsed"
                       IsSettingsVisible="True"
                       PaneDisplayMode="Left"
                       SelectionChanged="NavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Browse" Tag="browse" Icon="Globe">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
                <NavigationViewItem Content="Installed" Tag="installed" Icon="List"/>
                <NavigationViewItem Content="Updates" Tag="updates" Icon="Refresh">
                    <NavigationViewItem.InfoBadge>
                        <InfoBadge x:Name="UpdatesBadge" Value="0"/>
                    </NavigationViewItem.InfoBadge>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" Margin="0"/>
        </NavigationView>
    </Grid>
</Window>
