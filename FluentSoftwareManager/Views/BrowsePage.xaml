<Page
    x:Class="FluentSoftwareManager.Views.BrowsePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:FluentSoftwareManager.Models"
    x:Name="PageRoot"
    mc:Ignorable="d">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Browse Packages"
                   Style="{StaticResource TitleTextBlockStyle}"
                   Margin="0,0,0,16"/>

        <!-- Search Bar and Filters -->
        <StackPanel Grid.Row="1" Spacing="12" Margin="0,0,0,16">
            <!-- Search Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <AutoSuggestBox Grid.Column="0"
                               PlaceholderText="Search for packages..."
                               QueryIcon="Find"
                               Text="{x:Bind ViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                               QuerySubmitted="SearchBox_QuerySubmitted"
                               Margin="0,0,12,0"/>

                <Button Grid.Column="1"
                        Command="{x:Bind ViewModel.RefreshCommand}"
                        ToolTipService.ToolTip="Refresh">
                    <FontIcon Glyph="&#xE72C;"/>
                </Button>
            </Grid>

            <!-- Filter and Sort Row -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter Label -->
                <TextBlock Grid.Column="0"
                          Text="Filter:"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <!-- Filter ComboBox -->
                <ComboBox Grid.Column="1"
                         ItemsSource="{x:Bind ViewModel.FilterOptions}"
                         SelectedIndex="{x:Bind ViewModel.SelectedFilter, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                         MinWidth="150"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,16,0"/>

                <!-- Sort Label -->
                <TextBlock Grid.Column="2"
                          Text="Sort by:"
                          VerticalAlignment="Center"
                          Margin="0,0,8,0"/>

                <!-- Sort ComboBox -->
                <ComboBox Grid.Column="3"
                         ItemsSource="{x:Bind ViewModel.SortOptions}"
                         SelectedIndex="{x:Bind ViewModel.SelectedSortBy, Mode=TwoWay, Converter={StaticResource EnumToIntConverter}}"
                         MinWidth="120"
                         HorizontalAlignment="Stretch"
                         Margin="0,0,8,0"/>

                <!-- Sort Order Button -->
                <Button Grid.Column="4"
                        Command="{x:Bind ViewModel.ToggleSortOrderCommand}"
                        ToolTipService.ToolTip="Toggle sort order">
                    <FontIcon Glyph="{x:Bind ViewModel.SortAscending, Mode=OneWay, Converter={StaticResource BoolToSortGlyphConverter}}"/>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Package List -->
        <ListView Grid.Row="2"
                 ItemsSource="{x:Bind ViewModel.Packages, Mode=OneWay}"
                 SelectedItem="{x:Bind ViewModel.SelectedPackage, Mode=TwoWay}"
                 SelectionMode="Single">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="models:Package">
                    <Grid Padding="12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Icon -->
                        <Border Grid.Column="0"
                               Width="48" Height="48"
                               Background="{ThemeResource AccentFillColorDefaultBrush}"
                               CornerRadius="8">
                            <FontIcon Glyph="&#xE896;" FontSize="24"/>
                        </Border>

                        <!-- Package Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name}"
                                      FontWeight="SemiBold"
                                      FontSize="14"/>
                            <TextBlock Text="{x:Bind Id}"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      FontSize="12"/>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Version}"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          FontSize="11"/>
                                <FontIcon Glyph="&#xE73E;"
                                         FontSize="10"
                                         Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                         Visibility="{x:Bind IsInstalled, Converter={StaticResource BoolToVisibilityConverter}}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Install Button -->
                        <Button Grid.Column="2"
                               Content="Install"
                               Command="{Binding DataContext.InstallPackageCommand, ElementName=PageRoot}"
                               CommandParameter="{x:Bind}"
                               Visibility="{x:Bind IsInstalled, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Status Bar -->
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ProgressRing Grid.Column="0"
                         IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                         Width="20" Height="20"
                         Margin="0,0,12,0"/>

            <TextBlock Grid.Column="1"
                      Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}"
                      VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Page>
