{
    "files.exclude": {
        "**/bin": true,
        "**/obj": true
    },
    "files.associations": {
        "*.xaml": "xml"
    },
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "files.encoding": "utf8",
    "files.eol": "\r\n",
    "[csharp]": {
        "editor.defaultFormatter": "ms-dotnettools.csharp",
        "editor.formatOnSave": true
    },
    "[xml]": {
        "editor.defaultFormatter": "redhat.vscode-xml",
        "editor.formatOnSave": true
    },
    "dotnet.defaultSolution": "FluentSoftwareManager.sln"
}
